<div class="entry-head">
  <div class="entry-source">
    <a href="<%= h @post_url %>" target="_blank" rel="noopener"><%= h(@title || @post_url) %></a> のはてブ一覧
  </div>
  <div class="bkm-count">
    <a href="https://b.hatena.ne.jp/entry/<%= h @post_url %>" target="_blank" rel="noopener">
      <span id="bkm-remaining-figure"><%= @bkm.size %></span>users
    </a>
  </div>
</div>

<label class="beat-toggle" for="beat-toggle-input">
  <input type="checkbox" id="beat-toggle-input">
  殴る
  <span class="warn">＊注意＊音が鳴ります</span>
</label>

<% if @bkm.empty? %>
  <p class="empty-state">ブックマークが見つかりませんでした。</p>
<% else %>
  <ul class="bkm-list" id="bkm-list">
    <% @bkm.each do |bm| %>
      <li class="bkm-item">
        <div class="bkm-user"><%= h bm.user %></div>
        <div class="bkm-row">
          <img src="<%= h bm.icon %>" width="40" height="40" alt="" loading="lazy">
          <div class="bkm-comment"><%= h bm.comment %></div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
